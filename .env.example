# Copia este archivo como .env.local y rellena los dos valores.
# Los encuentras en Supabase: Project Settings > API.
# La clave "anon" / "publishable" es PÚBLICA por diseño: la seguridad real la dan las políticas RLS.
# NUNCA pongas aquí la clave "service_role" ni "secret".
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anon-publica
